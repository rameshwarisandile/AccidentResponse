<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/view_toolbar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                style="@style/Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView style="@style/Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Incident ID" />
                <TextView android:id="@+id/tvDetailId" style="@style/Value" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" />

                <TextView style="@style/Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Event Type" />
                <TextView android:id="@+id/tvDetailType" style="@style/Value" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" />

                <TextView style="@style/Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Status" />
                <TextView android:id="@+id/tvDetailStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:layout_marginTop="4dp" android:textSize="13sp" android:textStyle="bold" />

                <TextView style="@style/Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Location" />
                <TextView android:id="@+id/tvDetailLocation" style="@style/Value" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" />

                <TextView style="@style/Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Coordinates" />
                <TextView android:id="@+id/tvDetailCoords" style="@style/Value" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" />

                <TextView style="@style/Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Date" />
                <TextView android:id="@+id/tvDetailDate" style="@style/Value" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" />

                <TextView style="@style/Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Time" />
                <TextView android:id="@+id/tvDetailTime" style="@style/Value" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" />

                <TextView style="@style/Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Description" />
                <TextView android:id="@+id/tvDetailDesc" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="@color/text" android:textSize="15sp" />
            </LinearLayout>

            <Button android:id="@+id/btnMap" style="@style/Btn" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Open in Google Maps" />
            <Button android:id="@+id/btnShare" style="@style/BtnOutline" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Share Incident Report" />
            <Button android:id="@+id/btnResolve" style="@style/BtnOutline" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Mark as Resolved" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
